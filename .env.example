# Shared DeepSeek credentials — used by every character.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email (IMAP/SMTP) credentials are per-character, in characters/<name>/conf.toml.
# See README.md "Characters" for the conf.toml schema.

# REST control API (localhost only).
API_PORT=3000
# API requests require `Authorization: Bearer <API_KEY>`. If unset, a random key
# is generated at startup and printed to the log. Set it here to pin a stable key.
# API_KEY=
