# Shared DeepSeek credentials — used by every character.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Email (IMAP/SMTP) credentials are per-character, in characters/<name>/conf.toml.
# See README.md "Characters" for the conf.toml schema.

# REST control API (localhost only).
API_PORT=3000
# REQUIRED — the bot exits at startup if this is missing.
# Generate one with: openssl rand -hex 24
API_KEY=
